# ---------------------------------------------------------------------------
# Zeus Platform — environment template.
# Copy to `.env` and fill with real values. NEVER commit `.env`.
# In production these are set as encrypted environment variables (Vercel).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ZEUS_ENV=development                 # development | staging | production
ZEUS_LOG_LEVEL=INFO

# --- Master secret (encrypts admin-managed secrets at rest) ----------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZEUS_SECRETS_ENCRYPTION_KEY=

# --- Sessions (refresh-token cookies) --------------------------------------
# The access JWT stays in browser memory; only this rotating, opaque refresh
# token is stored, in a cookie script cannot read.
ZEUS_SESSION_COOKIE_NAME=zeus_session
ZEUS_SESSION_CSRF_COOKIE_NAME=zeus_csrf
# Off for local HTTP only. Forced on when ZEUS_ENV=production.
ZEUS_SESSION_COOKIE_SECURE=false
# "lax" lets the cookie ride the redirect back from Stripe Checkout;
# "strict" breaks that return.
ZEUS_SESSION_COOKIE_SAMESITE=lax
# Set only if the API and console live on different subdomains.
ZEUS_SESSION_COOKIE_DOMAIN=
# Absolute session lifetime; rotation issues new tokens but never extends it.
ZEUS_SESSION_TTL_DAYS=14

# --- LLM provider (pluggable, de-lock-in) ----------------------------------
# Which provider the factory uses: openai | anthropic | gemini
ZEUS_LLM_PROVIDER=openai
ZEUS_LLM_MODEL=gpt-4o-mini
ZEUS_LLM_TIMEOUT_SECONDS=60
# Only the key for the selected provider is required.
ZEUS_OPENAI_API_KEY=
ZEUS_ANTHROPIC_API_KEY=
ZEUS_GEMINI_API_KEY=

# Resilience. Every provider is wrapped in retries + a circuit breaker, so a
# rate limit or a brief outage does not surface as a failed analysis.
# Attempts include the first try. Backoff is exponential with full jitter.
ZEUS_LLM_MAX_ATTEMPTS=3
ZEUS_LLM_RETRY_BASE_DELAY=0.5
ZEUS_LLM_RETRY_MAX_DELAY=8.0
# After this many consecutive failures the circuit opens and calls fail fast
# for the recovery window, instead of every request hanging on a dead provider.
ZEUS_LLM_BREAKER_FAILURE_THRESHOLD=5
ZEUS_LLM_BREAKER_RECOVERY_SECONDS=30

# Chunking for long documents. Uploaded PDFs routinely exceed a context window,
# so bodies larger than CHUNK_CHARS are split, extracted per chunk, then merged
# and de-duplicated. Overlap prevents an obligation spanning a cut from being
# seen only in fragments. Roughly 4 chars per token.
ZEUS_LLM_CHUNK_CHARS=24000
ZEUS_LLM_CHUNK_OVERLAP_CHARS=1500
# Upper bound on model calls per analysis — a cost guard for huge uploads.
ZEUS_LLM_MAX_CHUNKS=24

# --- Cache (Redis / Upstash) -----------------------------------------------
ZEUS_CACHE_PROVIDER=redis
ZEUS_REDIS_URL=                      # e.g. rediss://default:...@...upstash.io:6379

# --- Database (Supabase Postgres) ------------------------------------------
ZEUS_DATABASE_PROVIDER=postgres
ZEUS_DATABASE_URL=                   # e.g. postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
ZEUS_DATABASE_POOL_MIN=1
ZEUS_DATABASE_POOL_MAX=10

# --- Queue (QStash, swappable to RabbitMQ later) ---------------------------
ZEUS_QUEUE_PROVIDER=qstash
ZEUS_QSTASH_TOKEN=
ZEUS_QSTASH_URL=https://qstash.upstash.io

# --- Auth (Supabase now, Keycloak-ready) -----------------------------------
ZEUS_AUTH_PROVIDER=supabase
ZEUS_SUPABASE_URL=
ZEUS_SUPABASE_ANON_KEY=
ZEUS_SUPABASE_SERVICE_ROLE_KEY=
ZEUS_SUPABASE_JWT_SECRET=

# --- Storage (documents + evidence) ----------------------------------------
# supabase = managed object store (production)
# local    = filesystem under ZEUS_STORAGE_LOCAL_PATH (dev, CI, self-hosted)
ZEUS_STORAGE_PROVIDER=supabase
ZEUS_STORAGE_BUCKET=evidence
ZEUS_STORAGE_LOCAL_PATH=./.zeus-storage
# Hard ceiling per uploaded document, enforced while streaming the request.
ZEUS_STORAGE_MAX_UPLOAD_MB=25

# --- Billing (Stripe) ------------------------------------------------------
ZEUS_BILLING_PROVIDER=stripe
ZEUS_STRIPE_SECRET_KEY=
# Webhook signature secret. Without it every webhook is rejected with a 400,
# which means paid subscriptions never grant access.
ZEUS_STRIPE_WEBHOOK_SECRET=
#
# IMPORTANT: platform.plans ships with PLACEHOLDER Stripe price ids
# (cc_starter_monthly, cc_growth_monthly, ...). Before taking real payments,
# create the prices in Stripe and update the rows:
#   UPDATE platform.plans SET stripe_price_id_monthly = 'price_1ABC...'
#    WHERE id = 'cc_growth';
# Checkout refuses any price that does not map to a known plan, so a
# misconfigured id fails at checkout rather than after the customer is charged.

# --- Observability (Grafana Cloud / OTel) ----------------------------------
ZEUS_OTEL_ENABLED=false
ZEUS_OTEL_EXPORTER_OTLP_ENDPOINT=
ZEUS_OTEL_EXPORTER_OTLP_HEADERS=
