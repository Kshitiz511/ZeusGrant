# ---------------------------------------------------------------------------
# Zeus Platform — environment template.
# Copy to `.env` and fill with real values. NEVER commit `.env`.
# In production these are set as encrypted environment variables (Vercel).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ZEUS_ENV=development                 # development | staging | production
ZEUS_LOG_LEVEL=INFO

# --- Master secret (encrypts admin-managed secrets at rest) ----------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZEUS_SECRETS_ENCRYPTION_KEY=

# --- LLM provider (pluggable, de-lock-in) ----------------------------------
# Which provider the factory uses: openai | anthropic | gemini
ZEUS_LLM_PROVIDER=openai
ZEUS_LLM_MODEL=gpt-4o-mini
ZEUS_LLM_TIMEOUT_SECONDS=60
# Only the key for the selected provider is required.
ZEUS_OPENAI_API_KEY=
ZEUS_ANTHROPIC_API_KEY=
ZEUS_GEMINI_API_KEY=

# --- Cache (Redis / Upstash) -----------------------------------------------
ZEUS_CACHE_PROVIDER=redis
ZEUS_REDIS_URL=                      # e.g. rediss://default:...@...upstash.io:6379

# --- Database (Supabase Postgres) ------------------------------------------
ZEUS_DATABASE_PROVIDER=postgres
ZEUS_DATABASE_URL=                   # e.g. postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
ZEUS_DATABASE_POOL_MIN=1
ZEUS_DATABASE_POOL_MAX=10

# --- Queue (QStash, swappable to RabbitMQ later) ---------------------------
ZEUS_QUEUE_PROVIDER=qstash
ZEUS_QSTASH_TOKEN=
ZEUS_QSTASH_URL=https://qstash.upstash.io

# --- Auth (Supabase now, Keycloak-ready) -----------------------------------
ZEUS_AUTH_PROVIDER=supabase
ZEUS_SUPABASE_URL=
ZEUS_SUPABASE_ANON_KEY=
ZEUS_SUPABASE_SERVICE_ROLE_KEY=
ZEUS_SUPABASE_JWT_SECRET=

# --- Storage (Supabase Storage) --------------------------------------------
ZEUS_STORAGE_PROVIDER=supabase
ZEUS_STORAGE_BUCKET=evidence

# --- Billing (Stripe) ------------------------------------------------------
ZEUS_BILLING_PROVIDER=stripe
ZEUS_STRIPE_SECRET_KEY=
ZEUS_STRIPE_WEBHOOK_SECRET=

# --- Observability (Grafana Cloud / OTel) ----------------------------------
ZEUS_OTEL_ENABLED=false
ZEUS_OTEL_EXPORTER_OTLP_ENDPOINT=
ZEUS_OTEL_EXPORTER_OTLP_HEADERS=
