# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node / Turbo
node_modules/
.turbo/
.next/
out/

# Vercel CLI local project link
.vercel/

# OS / editor
.DS_Store
*.log

# TS incremental build cache
*.tsbuildinfo
.vercel

# Vendored reference checkouts. These are separate git repositories, so a
# `git add -A` commits them as gitlinks that no clone can resolve and CI
# cannot check out. They are also excluded from pytest testpaths and ruff.
/graphify/
/ponytail/
/ui-ux-pro-max-skill/
/.github/prompts/ui-ux-pro-max/
